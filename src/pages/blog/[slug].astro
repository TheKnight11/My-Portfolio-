---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="py-20 px-5 sm:px-8">
    <div class="max-w-3xl mx-auto">
      {post.data.category && <span class="font-mono text-[0.68rem] uppercase tracking-wide bg-amber-soft text-bronze px-2 py-1 rounded-full">{post.data.category}</span>}
      <h1 class="font-display font-semibold text-3xl sm:text-4xl text-navy mt-4 mb-2">{post.data.title}</h1>
      <p class="text-sm text-slate mb-8">
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>

      {post.data.coverImage && (
        <img src={post.data.coverImage} alt={post.data.title} class="w-full rounded-lg border border-line mb-8" />
      )}

      <div class="prose prose-lg max-w-none text-ink leading-relaxed">
        <Content />
      </div>

      {post.data.downloadFile && (
        <a href={post.data.downloadFile} download class="inline-block mt-8 bg-navy text-paper px-6 py-3 rounded-md text-sm font-semibold hover:bg-navy-2 transition">
          Download Attachment
        </a>
      )}

      <div class="mt-12">
        <a href="/blog" class="text-bronze font-medium hover:underline">← Back to Blog</a>
      </div>
    </div>
  </article>
</BaseLayout>
