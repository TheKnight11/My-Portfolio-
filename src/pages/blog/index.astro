---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog', ({ data }) => data.draft !== true);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Blog">
  <section class="py-20 px-5 sm:px-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="font-display font-semibold text-4xl text-navy mb-10">Blog</h1>
      <div class="space-y-8">
        {posts.map((post) => (
          <article class="border-b border-line pb-8">
            {post.data.category && <span class="font-mono text-[0.68rem] uppercase tracking-wide bg-amber-soft text-bronze px-2 py-1 rounded-full">{post.data.category}</span>}
            <h2 class="font-display font-semibold text-2xl text-navy mt-3 mb-2">
              <a href={`/blog/${post.slug}`} class="hover:text-bronze transition">{post.data.title}</a>
            </h2>
            <p class="text-sm text-slate mb-2">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            {post.data.excerpt && <p class="text-ink">{post.data.excerpt}</p>}
          </article>
        ))}
        {posts.length === 0 && <p class="text-slate">No posts published yet — add one from /admin.</p>}
      </div>
    </div>
  </section>
</BaseLayout>
