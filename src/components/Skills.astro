---
const { data } = Astro.props;
---
<section id="skills" class="py-20 px-5 sm:px-8 bg-paper-2">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-display font-semibold text-3xl sm:text-4xl text-navy mb-10">Skills</h2>
    <div class="grid md:grid-cols-2 gap-8">
      {data.skillGroups?.map((group) => (
        <div>
          <p class="font-mono text-xs uppercase tracking-wide text-bronze mb-3">{group.groupName}</p>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="border border-line bg-white/60 rounded-full px-3.5 py-1.5 text-sm">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
