---
import { getCollection } from 'astro:content';

const { data } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => data.draft !== true);
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---
<section id="blog" class="py-20 px-5 sm:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="font-display font-semibold text-3xl sm:text-4xl text-navy mb-2">{data.blogTitle}</h2>
        {data.blogSubtitle && <p class="text-slate">{data.blogSubtitle}</p>}
      </div>
      <a href="/blog" class="text-sm font-semibold text-bronze hover:underline whitespace-nowrap">View all →</a>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      {posts.map((post) => (
        <article class="bg-white/60 border border-line rounded-lg overflow-hidden hover:-translate-y-1 hover:border-bronze transition">
          {post.data.coverImage && <img src={post.data.coverImage} alt={post.data.title} class="w-full h-40 object-cover" />}
          <div class="p-6">
            {post.data.category && <span class="font-mono text-[0.68rem] uppercase tracking-wide bg-amber-soft text-bronze px-2 py-1 rounded-full">{post.data.category}</span>}
            <h3 class="font-display font-semibold text-xl mt-3 mb-2 text-navy">
              <a href={`/blog/${post.slug}`} class="hover:text-bronze transition">{post.data.title}</a>
            </h3>
            {post.data.excerpt && <p class="text-sm text-slate">{post.data.excerpt}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
