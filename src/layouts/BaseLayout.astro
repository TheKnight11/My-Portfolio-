---
import { getEntry } from 'astro:content';
const settings = await getEntry('settings', 'general');

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${settings.data.siteName}` : settings.data.siteName;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description || settings.data.tagline} />
  {settings.data.favicon && <link rel="icon" href={settings.data.favicon} />}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="bg-paper text-ink font-sans antialiased">
  <header class="fixed top-0 left-0 right-0 z-50 border-b border-line bg-paper/90 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="font-display font-semibold text-lg text-navy">{settings.data.siteName}</a>
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
          <a href="/#about" class="hover:text-bronze transition">About</a>
          <a href="/#projects" class="hover:text-bronze transition">Projects</a>
          <a href="/#skills" class="hover:text-bronze transition">Skills</a>
          <a href="/blog" class="hover:text-bronze transition">Blog</a>
          <a href="/#contact" class="hover:text-bronze transition">Contact</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="pt-16">
    <slot />
  </main>

  <footer class="py-8 px-5 sm:px-8 bg-navy border-t border-white/10">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-[#a9bacb]">
      <p>{settings.data.footerText}</p>
      {settings.data.resumeFile && (
        <a href={settings.data.resumeFile} download class="text-amber font-medium hover:underline">Download Résumé (PDF)</a>
      )}
    </div>
  </footer>
</body>
</html>
